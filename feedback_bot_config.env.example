# Скопируйте в feedback_bot_config.env (тот файл в .gitignore) и заполните.
BOT_TOKEN=
# chat_id Максима и Антона через запятую — сюда пересылаются готовые заявки.
# Узнать свой chat_id: написать что угодно уже запущенному боту, посмотреть
# в journalctl -u myavto-feedback-bot строку "сообщение из chat_id=...".
MANAGER_CHAT_IDS=
# Опционально — тот же формат, что и в bot_config.env/userbot_config.env,
# нужен только если api.telegram.org снова заблокирован с этого VPS.
PROXY_URL=
