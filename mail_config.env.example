# Скопируй этот файл в mail_config.env (без .example) и заполни реальными
# значениями. mail_config.env НЕ попадает в git (см. .gitignore) — пароль
# нигде не публикуется.
#
# Для Gmail (если письмо будет уходить с lesnikovmn@gmail.com):
# 1. Включи двухфакторную аутентификацию (если ещё не включена):
#    https://myaccount.google.com/security
# 2. Создай "пароль приложения" (обычный пароль от Gmail тут не сработает,
#    Google требует отдельный пароль именно для приложений/скриптов):
#    https://myaccount.google.com/apppasswords
#    Выбери "Другое (собственное название)", впиши что угодно (например
#    "myavto-agregator"), скопируй получившиеся 16 символов без пробелов.
# 3. Впиши их сюда как SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=lesnikovmn@gmail.com
SMTP_PASSWORD=впиши_сюда_16_символов_пароля_приложения
FROM_NAME=Максим, MyAvtoAgregator.ru

# ADMIN_EMAIL — 14.08.2026, используется telegram_bot_service.py: сюда
# дублируются те же уведомления, что уже приходят в Telegram (ADMIN_CHAT_ID)
# — новая заявка, подтверждение клиентом, онбординг компании, ответ
# компании. Если оставить пустым — письма пойдут на тот же SMTP_USER (то
# есть сам себе). Нужен этот же файл ЕЩЁ И на VPS (скопируй туда же, где
# лежит bot_config.env) — send_onboarding_emails.py на Маке его тоже
# использует, это один и тот же файл/формат для обоих скриптов.
ADMIN_EMAIL=lesnikovmn@gmail.com
