# Скопируйте в userbot_config.env и заполните (тот файл в .gitignore).
PHONE=
API_ID=
API_HASH=
# Прямой доступ к Telegram с VPS заблокирован хостером — нужен прокси.
# Тот же, что уже используется в bot_config.env/agent_config.env.
PROXY_URL=
# T-77: парсер источников
# winner_auto_club добавлен 25.08.2026 (цены в $, авто удаляет водяной
# знак канала — согласовано с собственником); tamsyam26 добавлен
# 25.08.2026 (T-82, цены в рублях, "под ключ" пересчитывается на
# доставку в Краснодар). Перед тем как дописывать новый источник сюда на
# боевом сервере — сначала прогнать один раз с DRY_RUN=true (или добавить
# в TEST_ONLY_SOURCES ниже) и проверить и текст, и фото в тестовой группе.
SOURCES=artalexgroup,bezpokrasa,winner_auto_club,tamsyam26
TARGET_OPTIMAL=@My_Avto_Optimal
TARGET_MY_AVTO5=@MY_Avto5
EUR_RUB_RATE=100
USD_RUB_RATE=80
DRY_RUN=true
# T-79 (25.08.2026): посты с видео из источников ниже (VIDEO_DRY_RUN_SOURCES)
# всегда идут в тестовую группу, пока снятие водяного знака с видео не
# подключено в проде — независимо от общего DRY_RUN выше.
VIDEO_DRY_RUN=true
# T-83 (25.08.2026): VIDEO_DRY_RUN применяется только к источникам из
# этого списка (по умолчанию winner_auto_club — там реальная причина,
# чужой водяной знак на видео). У остальных источников видео идёт как
# фото/текст, по обычному DRY_RUN — не добавляйте источник сюда без
# причины, иначе его видео без нужды будет уходить в тест.
VIDEO_DRY_RUN_SOURCES=winner_auto_club
# T-82 (25.08.2026): источники из этого списка ВСЕГДА идут только в
# тестовую группу, независимо от DRY_RUN/VIDEO_DRY_RUN — для новых
# источников, чей парсер/цена ещё не обкатаны на реальном трафике. Убрать
# источник отсюда, когда результат в тесте устроит.
# tamsyam26 переведён в боевые 26.08.2026 (парсинг подтверждён 2 реальными
# постами). winner_auto_club добавлен 26.08.2026 (T-85) — удаление
# водяного знака с фото сломано (не находит бейдж, портит случайные места),
# держим в тесте, пока не будет рабочего распознавания.
TEST_ONLY_SOURCES=winner_auto_club
TEST_BACKFILL_LIMIT=5
TEST_GROUP_INVITE=
# T-78: бот обратной связи — username без @ (см. feedback_bot.py). Если не
# задан, в футере постов просто не будет строки "Оставить заявку боту".
FEEDBACK_BOT_USERNAME=
# T-158 (08.09.2026, уточнено пользователем — "по 1 из каждой группы,
# самое привлекательное предложение"): раз в сутки (STATUS_CARD_DAILY_HOUR)
# отдельно для TARGET_MY_AVTO5 и для TARGET_OPTIMAL выбирается ОДИН пост
# за прошедшие сутки (и ботом опубликованный, и вручную админом — см.
# status_card.py/status_card_parser.py) с наибольшим числом заполненных
# полей карточки, генерируется и шлётся карточка. НЕ карточка на каждый
# пост. По умолчанию выключено. Результат ВСЕГДА уходит только в
# TEST_GROUP_INVITE выше (обязателен, если включаете это) — публикация в
# боевые каналы не делается, пока качество не проверено на реальном
# потоке. Если за сутки ни у одного поста не хватило данных (бренд/модель/
# цена) или не нашлось поста с фото — за этот день карточка не публикуется
# (см. TASKS.md T-158).
STATUS_CARD_ENABLED=false
# Час (0-23) по МСК, когда раз в сутки запускается подбор — по умолчанию
# 20 (20:00 МСК).
STATUS_CARD_DAILY_HOUR=20
# Не в git (как и BADGE_ARCHIVE_DIR) — отдельная папка на диске для
# накопления сгенерированных карточек (или причины пропуска) для ручной
# проверки качества парсера/рендера. Не задано — архивирование выключено.
STATUS_CARD_ARCHIVE_DIR=
# T-160 (09.09.2026, запрошено пользователем — "через юзербота можна ложить
# в группу предпостинг рилс", уточнено — "только в группу предпостинга"):
# ссылка-приглашение на группу для рилс-роликов (auto_montage.build_short —
# короткий вертикальный формат с текстом на видео) — ручной отбор/заливка в
# Instagram вручную. Когда задано, смонтированный ролик уходит ТОЛЬКО сюда —
# не в MY_Avto5/My_Avto_Optimal/тестовую, независимо от цены/DRY_RUN/окна
# постинга (остальное медиа того же поста — фото/текст без монтажа — идёт по
# обычной логике, эта ссылка их не касается). Не задано — поведение как
# раньше (ролик идёт по обычной логике роутинга поста).
PREPOSTING_GROUP_INVITE=https://t.me/+_73REn1NkuFmNGU6
# T-165 (12.09.2026, запрошено пользователем — "как можно сделать
# автопостинг карточки дня в статсы ТГ, и в статус инсты?", уточнено —
# "от имени каналов и в мой личный номер @LesnikovM"): когда включено,
# карточка "Предложение дня" (T-158) ПОМИМО отправки сообщением (см.
# STATUS_CARD_ENABLED выше) дополнительно публикуется как Telegram Story —
# от имени самого канала (MY_Avto5/My_Avto_Optimal) и на личный аккаунт
# ("me", требует Telegram Premium). Instagram Stories отдельно не
# реализованы — уже работающий отдельный проект omni-poster
# (stories-sync, крон каждые 5 минут) сам подхватывает новые TG Stories и
# зеркалит их в Instagram Stories, поэтому здесь достаточно только
# публикации в Telegram. По умолчанию ВЫКЛЮЧЕНО — включать только после
# ручной проверки через test_send_story_once.py (см. TASKS.md T-165):
# stories.sendStory ни разу не проверялся на реальном аккаунте, механизм
# может упереться в PREMIUM_ACCOUNT_REQUIRED/BOOSTS_REQUIRED/
# CHAT_ADMIN_REQUIRED.
STATUS_CARD_STORY_ENABLED=false
