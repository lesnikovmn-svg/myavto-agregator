# Скопируйте в userbot_config.env и заполните (тот файл в .gitignore).
PHONE=
API_ID=
API_HASH=
# Прямой доступ к Telegram с VPS заблокирован хостером — нужен прокси.
# Тот же, что уже используется в bot_config.env/agent_config.env.
PROXY_URL=
# T-77: парсер источников
# winner_auto_club добавлен 25.08.2026 (цены в $, авто удаляет водяной
# знак канала — согласовано с собственником); tamsyam26 добавлен
# 25.08.2026 (T-82, цены в рублях, "под ключ" пересчитывается на
# доставку в Краснодар). Перед тем как дописывать новый источник сюда на
# боевом сервере — сначала прогнать один раз с DRY_RUN=true (или добавить
# в TEST_ONLY_SOURCES ниже) и проверить и текст, и фото в тестовой группе.
SOURCES=artalexgroup,bezpokrasa,winner_auto_club,tamsyam26
TARGET_OPTIMAL=@My_Avto_Optimal
TARGET_MY_AVTO5=@MY_Avto5
EUR_RUB_RATE=100
USD_RUB_RATE=80
DRY_RUN=true
# T-79 (25.08.2026): посты с видео всегда идут в тестовую группу, пока
# снятие водяного знака с видео не подключено в проде — независимо от
# общего DRY_RUN выше.
VIDEO_DRY_RUN=true
# T-82 (25.08.2026): источники из этого списка ВСЕГДА идут только в
# тестовую группу, независимо от DRY_RUN/VIDEO_DRY_RUN — для новых
# источников, чей парсер/цена ещё не обкатаны на реальном трафике. Убрать
# источник отсюда, когда результат в тесте устроит.
TEST_ONLY_SOURCES=tamsyam26
TEST_BACKFILL_LIMIT=5
TEST_GROUP_INVITE=
# T-78: бот обратной связи — username без @ (см. feedback_bot.py). Если не
# задан, в футере постов просто не будет строки "Оставить заявку боту".
FEEDBACK_BOT_USERNAME=
