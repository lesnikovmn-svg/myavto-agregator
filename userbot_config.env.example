# Скопируйте в userbot_config.env и заполните (тот файл в .gitignore).
PHONE=
API_ID=
API_HASH=
# Прямой доступ к Telegram с VPS заблокирован хостером — нужен прокси.
# Тот же, что уже используется в bot_config.env/agent_config.env.
PROXY_URL=
# T-77: парсер источников
# winner_auto_club добавлен 25.08.2026 (цены в $, авто удаляет водяной
# знак канала — согласовано с собственником); перед тем как дописывать
# его сюда на боевом сервере — сначала прогнать один раз с DRY_RUN=true
# и проверить и текст, и фото в тестовой группе.
SOURCES=artalexgroup,bezpokrasa
TARGET_OPTIMAL=@My_Avto_Optimal
TARGET_MY_AVTO5=@MY_Avto5
EUR_RUB_RATE=100
USD_RUB_RATE=80
DRY_RUN=true
# T-79 (25.08.2026): отдельный переключатель для постов С ВИДЕО — пока
# снятие водяного знака с видео (winner_auto_club) не подключено в проде,
# держим true, даже когда общий DRY_RUN уже false (боевой режим для
# фото/текста). Такие посты всегда уходят в TEST_GROUP_INVITE целиком.
VIDEO_DRY_RUN=true
TEST_BACKFILL_LIMIT=5
TEST_GROUP_INVITE=
# T-78: бот обратной связи — username без @ (см. feedback_bot.py). Если не
# задан, в футере постов просто не будет строки "Оставить заявку боту".
FEEDBACK_BOT_USERNAME=
